# ============================================================
# SISTEMA RH - Seguridad y reescritura
# ============================================================

# Codificación por defecto
AddDefaultCharset UTF-8

# Denegar listado de directorios
Options -Indexes

# Proteger archivo .htaccess
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# Redirigir todo al index.php (single entry point)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirigir HTTP a HTTPS (excepto en localhost/XAMPP)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Denegar acceso directo a directorios sensibles
    RewriteRule ^config/.*$ - [F,L]
    RewriteRule ^includes/.*$ - [F,L]
    RewriteRule ^sql/.*$ - [F,L]
    RewriteRule ^tests/.*$ - [F,L]
    RewriteRule ^vendor/.*$ - [F,L]
    RewriteRule ^\.opencode/.*$ - [F,L]

    # Denegar acceso a archivos sensibles
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.env\.example$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule ^phpunit\.xml$ - [F,L]
    RewriteRule ^\.phpunit\.cache(/|$) - [F,L]
    RewriteRule ^_test.*\.php$ - [F,L]
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^\.gitignore$ - [F,L]

    # Si el archivo o directorio existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Prevenir clickjacking
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Cache estático para assets
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|svg|woff2?)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>
