APP_URL=http://localhost/Sistema%20RH
APP_NAME="Sistema Integral RH"

# Desarrollo (XAMPP)
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_rh
DB_USER=root
DB_PASS=

# Producción — reemplaza por las credenciales de tu servidor (no las subas al repo):
# APP_ENV=production
# SESSION_COOKIE_SECURE=true
# DB_HOST=mysql.tudominio.com
# DB_PORT=3306
# DB_NAME=nombre_bd
# DB_USER=usuario_bd
# DB_PASS=password_seguro
# MAIL_FROM=noreply@tudominio.com

# SMTP (recomendado para el correo transaccional en hosting compartido)
# SMTP_HOST=mail.tudominio.com
# SMTP_PORT=465
# SMTP_USER=noreply@tudominio.com
# SMTP_PASS=password_smtp
# SMTP_ENCRYPTION=ssl   # ssl (465) o tls (587); 'none' para SMTP sin cifrado

SESSION_TIMEOUT=1800
UPLOAD_MAX_SIZE=5242880
LATE_THRESHOLD=09:05
JORNADA_HORAS=8
MAIL_FROM=noreply@midominio.com
