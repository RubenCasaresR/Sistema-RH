# Deshabilitar ejecución de scripts PHP en uploads/ (defensa en profundidad)
# En XAMPP (PHP como módulo Apache) esto desactiva el motor de PHP.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Denegar acceso directo a extensiones sensibles y archivos ejecutables.
# Los directorios documents/ y cvs/ se protegen con su propio .htaccess (Require all denied)
# y sus archivos solo se sirven vía api/files.php y api/cv.php.
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh)(\.|$)">
    Require all denied
</FilesMatch>

<FilesMatch "\.(pdf|doc|docx|xls|xlsx|zip|rar|txt)$">
    Require all denied
</FilesMatch>
